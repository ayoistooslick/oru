<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Oru app theme: clay + ember on soft cream paper, Material 3 light -->
    <style name="Theme.Oru" parent="Theme.Material3.Light.NoActionBar">
        <!-- Surface: paper -->
        <item name="colorSurface">@color/paper</item>
        <item name="colorSurfaceVariant">@color/card</item>
        <item name="colorSurfaceInverse">@color/card_hi</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorPrimary">@color/flame</item>
        <item name="colorPrimaryVariant">@color/flame_ink</item>
        <item name="colorOnPrimary">@color/night</item>
        <item name="colorSecondary">@color/ink_soft</item>
        <item name="colorSecondaryVariant">@color/ink_faint</item>
        <item name="colorOnSecondary">@color/night</item>
        <item name="colorError">@color/flame_ink</item>
        <item name="colorOnError">@color/cream</item>
        <item name="colorErrorContainer">@color/flame_soft</item>
        <item name="colorOnErrorContainer">@color/flame_ink</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper_deep</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Everything wears Outfit unless a style says otherwise. The family
             is pinned to 500: the default 400 read as hairlines on a phone. -->
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textViewStyle">@style/Widget.Oru.TextView</item>
        <item name="android:editTextStyle">@style/Widget.Oru.EditText</item>
    </style>

    <!-- Splash style -->
    <style name="Theme.Oru.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Oru</item>
    </style>

    <!-- Default widgets pick up the typeface -->
    <style name="Widget.Oru.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/outfit_medium</item>
    </style>
    <style name="Widget.Oru.EditText" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/outfit_medium</item>
    </style>

    <!-- Text styles: Outfit for reading, Fraunces for display. Weights are
         pinned to the variable axis so words carry on a phone screen. -->
    <style name="TextAppearance.Oru.Display" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Oru.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">31sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Oru.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Oru.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Oru.BodySoft" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>
    <style name="TextAppearance.Oru.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_faint</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Card style -->
    <style name="Widget.Oru.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/hair</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Oru.Card.Clickable" parent="Widget.Oru.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Button: Material filled, ember -->
    <style name="Widget.Oru.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/flame</item>
        <item name="android:textColor">@color/night</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="Widget.Oru.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/flame</item>
        <item name="android:textColor">@color/flame_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="Widget.Oru.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/flame_ink</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Input field -->
    <style name="Widget.Oru.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/flame</item>
        <item name="hintTextColor">@color/ink_soft</item>
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Bottom navigation: ember accent -->
    <style name="Widget.Oru.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/paper</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Oru.BottomNavigation.ActiveIndicator</item>
    </style>
    <style name="Widget.Oru.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/flame_soft</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.Oru.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/paper_deep</item>
        <item name="titleTextAppearance">@style/TextAppearance.Oru.Title</item>
        <item name="titleTextColor">@color/ink</item>
        <item name="navigationIconTint">@color/ink_soft</item>
        <item name="subtitleTextColor">@color/ink_faint</item>
    </style>

    <!-- Chip: ember outline -->
    <style name="Widget.Oru.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipStrokeColor">@color/hair</item>
        <item name="chipCornerRadius">10dp</item>
    </style>

    <!-- FAB: ember -->
    <style name="Widget.Oru.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/flame</item>
        <item name="tint">@color/night</item>
    </style>
<style name="ShapeAppearance.Oru.Circle" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">50%</item>
</style>
</resources>
