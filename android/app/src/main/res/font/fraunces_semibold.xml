<?xml version="1.0" encoding="utf-8"?>
<!-- Fraunces carries the headlines. 600 keeps the strokes visible on a phone. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/fraunces"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600, 'SOFT' 40, 'WONK' 0" />
</font-family>
