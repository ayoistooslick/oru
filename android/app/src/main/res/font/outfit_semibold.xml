<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit's variable axis, pinned to a heavier weight. Kept as a family so
     API 26+ gets the real 600 glyphs and older phones fall back to the base. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/outfit"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
</font-family>
