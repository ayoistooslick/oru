<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_left"
            app:navigationIconTint="@color/ink"
            app:title="Your profile"
            app:titleTextColor="@color/ink" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="28dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/bannerImage"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@color/card_hi"
                android:contentDescription="Banner"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />

            <ImageView
                android:id="@+id/avatarImage"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-48dp"
                android:background="@drawable/avatar_ring"
                android:clipToOutline="true"
                android:contentDescription="Profile picture"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_artist" />

            <TextView
                android:id="@+id/displayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Oru.Headline"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/handleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                android:textColor="@color/ink_soft" />

            <TextView
                android:id="@+id/bioText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_surface"
                android:padding="16dp"
                android:textAppearance="@style/TextAppearance.Oru.Body"
                android:textColor="@color/ink_soft"
                android:visibility="gone" />

            <TextView
                android:id="@+id/artistNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:text="Publishing as an artist. Your songs, releases and posts live in the studio."
                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                android:textColor="@color/ink_soft"
                android:visibility="gone" />

            <!-- The doors, in the order they matter. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/artistPageRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ink_faint"
                    android:padding="14dp"
                    android:text="Open your artist page"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/studioRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ink_faint"
                    android:padding="14dp"
                    android:text="Your studio"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/editRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ink_faint"
                    android:padding="14dp"
                    android:text="Edit your details"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/settingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ink_faint"
                    android:padding="14dp"
                    android:text="Settings"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/logOutRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="14dp"
                    android:text="Log out"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/flame_ink" />

            </LinearLayout>

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                android:textColor="@color/flame_ink"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/flame" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
