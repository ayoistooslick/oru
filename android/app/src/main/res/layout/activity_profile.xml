<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="132dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Shorter than it was: the cover introduces you, it is not the
                 page. -->
            <FrameLayout
                android:id="@+id/bannerTapTarget"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@color/card_hi">

                <ImageView
                    android:id="@+id/bannerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Your banner"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:background="@drawable/bg_banner_top_scrim" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_banner_fade" />

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_scrim"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/cream" />

                <ImageButton
                    android:id="@+id/shareButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="62dp"
                    android:background="@drawable/bg_circle_scrim"
                    android:contentDescription="Share your page"
                    android:padding="10dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/cream" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_scrim"
                    android:contentDescription="Settings"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/cream" />

                <TextView
                    android:id="@+id/changeBannerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_pill_scrim"
                    android:drawableStart="@drawable/ic_image"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/cream"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="Change cover"
                    android:textAppearance="@style/TextAppearance.Oru.Label"
                    android:textColor="@color/cream" />

            </FrameLayout>

            <!-- The face sits half over the cover. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-42dp">

                <ImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/avatar_ring"
                    android:clipToOutline="true"
                    android:contentDescription="Your picture"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_artist" />

                <ImageButton
                    android:id="@+id/editAvatarButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_gear_flame"
                    android:contentDescription="Change your picture"
                    android:elevation="5dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/night" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/displayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Oru.Headline"
                    android:textColor="@color/ink" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/handleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                        android:textColor="@color/ink_soft" />

                    <TextView
                        android:id="@+id/roleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stat_tile"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textAppearance="@style/TextAppearance.Oru.Label"
                        android:textColor="@color/flame_ink"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/bioText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.25"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink_soft"
                    android:visibility="gone" />

                <!-- The two numbers that matter, as words rather than three
                     tiles: who you follow, and for an artist, who follows you. -->
                <TextView
                    android:id="@+id/followLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/ink_soft" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfileButton"
                    style="@style/Widget.Oru.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Edit profile"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconTint="@color/night" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Your ORU"
                    android:textAppearance="@style/TextAppearance.Oru.Label"
                    android:textColor="@color/ink_faint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <LinearLayout
                        android:id="@+id/studioRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_studio"
                            app:tint="@color/flame_ink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Your studio"
                                android:textAppearance="@style/TextAppearance.Oru.Body"
                                android:textColor="@color/ink" />

                            <TextView
                                android:id="@+id/studioSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Upload songs and publish them"
                                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                                android:textColor="@color/ink_faint" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_faint" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dropsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_inbox"
                            app:tint="@color/flame_ink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Drops"
                                android:textAppearance="@style/TextAppearance.Oru.Body"
                                android:textColor="@color/ink" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="What was shared with you"
                                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                                android:textColor="@color/ink_faint" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_faint" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/artistPageRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_artist"
                            app:tint="@color/flame_ink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Your artist page"
                                android:textAppearance="@style/TextAppearance.Oru.Body"
                                android:textColor="@color/ink" />

                            <TextView
                                android:id="@+id/artistNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="The page listeners see"
                                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                                android:textColor="@color/ink_faint" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_faint" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/settingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/flame_ink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Settings"
                                android:textAppearance="@style/TextAppearance.Oru.Body"
                                android:textColor="@color/ink" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Theme, downloads, notifications"
                                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                                android:textColor="@color/ink_faint" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_faint" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/logOutRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_logout"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/flame_ink"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:text="Log out"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/flame_ink" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/flame_ink"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/flame" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <include
            android:id="@+id/miniPlayer"
            layout="@layout/view_mini_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/profileNav"
            style="@style/Widget.Oru.BottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/paper"
            app:itemIconTint="@color/bottom_nav_item_color"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
