<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The banner: anyone can put a picture here, artists or listeners. -->
            <FrameLayout
                android:id="@+id/bannerTapTarget"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@color/card_hi">

                <ImageView
                    android:id="@+id/bannerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Your banner"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_banner_top_scrim" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_banner_fade" />

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_scrim"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/cream" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_scrim"
                    android:contentDescription="Settings"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/cream" />

                <TextView
                    android:id="@+id/changeBannerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_pill_scrim"
                    android:drawableStart="@drawable/ic_image"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/cream"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="Change cover"
                    android:textAppearance="@style/TextAppearance.Oru.Label"
                    android:textColor="@color/cream" />

            </FrameLayout>

            <!-- The face sits half over the banner. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-54dp">

                <ImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:background="@drawable/avatar_ring"
                    android:clipToOutline="true"
                    android:contentDescription="Your picture"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_artist" />

                <ImageButton
                    android:id="@+id/editAvatarButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_gear_flame"
                    android:contentDescription="Change your picture"
                    android:elevation="5dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/night" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/displayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Oru.Display"
                    android:textColor="@color/ink" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/handleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                        android:textColor="@color/ink_soft" />

                    <TextView
                        android:id="@+id/roleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stat_tile"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textAppearance="@style/TextAppearance.Oru.Label"
                        android:textColor="@color/flame_ink"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/bioText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink_soft"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/joinedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Oru.Label"
                    android:textColor="@color/ink_faint" />

                <!-- Three numbers that describe a listener at a glance. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_tile"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/statLikes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Oru.Title"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Liked"
                            android:textAppearance="@style/TextAppearance.Oru.Label"
                            android:textColor="@color/ink_faint" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_tile"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/statPlaylists"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Oru.Title"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Playlists"
                            android:textAppearance="@style/TextAppearance.Oru.Label"
                            android:textColor="@color/ink_faint" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_tile"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/statFollowing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Oru.Title"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Following"
                            android:textAppearance="@style/TextAppearance.Oru.Label"
                            android:textColor="@color/ink_faint" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfileButton"
                    style="@style/Widget.Oru.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Edit profile"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconTint="@color/night" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Your ORU"
                    android:textAppearance="@style/TextAppearance.Oru.Label"
                    android:textColor="@color/ink_faint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <LinearLayout
                        android:id="@+id/studioRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_studio"
                            app:tint="@color/flame_ink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Your studio"
                                android:textAppearance="@style/TextAppearance.Oru.Body"
                                android:textColor="@color/ink" />

                            <TextView
                                android:id="@+id/studioSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Upload songs and publish them"
                                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                                android:textColor="@color/ink_faint" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_faint" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/artistPageRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_artist"
                            app:tint="@color/flame_ink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Your artist page"
                                android:textAppearance="@style/TextAppearance.Oru.Body"
                                android:textColor="@color/ink" />

                            <TextView
                                android:id="@+id/artistNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="The page listeners see"
                                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                                android:textColor="@color/ink_faint" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_faint" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/settingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/flame_ink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Settings"
                                android:textAppearance="@style/TextAppearance.Oru.Body"
                                android:textColor="@color/ink" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Theme, downloads, notifications"
                                android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                                android:textColor="@color/ink_faint" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_faint" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/logOutRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_logout"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/flame_ink"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:text="Log out"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/flame_ink" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/flame_ink"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/flame" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
