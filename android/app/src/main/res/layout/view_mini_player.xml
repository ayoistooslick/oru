<?xml version="1.0" encoding="utf-8"?>
<!-- The bar every web page carries: what is playing and how to steer it. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="6dp"
    android:visibility="gone"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/hair"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="6dp"
            android:paddingBottom="7dp">

            <ImageView
                android:id="@+id/miniCover"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/artwork_rounded"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/ink_soft" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/miniShuffle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Shuffle"
                android:padding="8dp"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/ink_faint" />

            <ImageButton
                android:id="@+id/miniPrevious"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous song"
                android:padding="8dp"
                android:src="@drawable/ic_skip_back"
                app:tint="@color/ink_soft" />

            <ImageButton
                android:id="@+id/miniPlayPause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/btn_play_background"
                android:contentDescription="Play or pause"
                android:padding="9dp"
                android:src="@drawable/ic_play"
                app:tint="@color/night" />

            <ImageButton
                android:id="@+id/miniNext"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next song"
                android:padding="8dp"
                android:src="@drawable/ic_skip_forward"
                app:tint="@color/ink_soft" />

            <ImageButton
                android:id="@+id/miniRepeat"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Repeat"
                android:padding="8dp"
                android:src="@drawable/ic_repeat"
                app:tint="@color/ink_faint" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/miniProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="8dp"
            app:indicatorColor="@color/flame"
            app:trackColor="@color/hair"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
