<?xml version="1.0" encoding="utf-8"?>
<!-- One card in the library grid: square art, a name, and what it holds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.oru.app.ui.components.SquareImageView
            android:id="@+id/tileArtwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/artwork_rounded"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Only the Liked Songs tile wears the heart. -->
        <ImageView
            android:id="@+id/tileOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_heart"
            android:tint="@color/cream"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Oru.Body"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/tileSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Oru.BodySoft"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

</LinearLayout>
