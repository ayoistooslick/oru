<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_left"
            app:navigationIconTint="@color/ink"
            app:title="Settings"
            app:titleTextColor="@color/ink" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- Who you are, as one card. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/avatarImage"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/avatar_ring"
                            android:clipToOutline="true"
                            android:contentDescription="Your picture"
                            android:padding="3dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_artist" />

                        <ImageButton
                            android:id="@+id/editAvatarButton"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_gear_flame"
                            android:contentDescription="Change your picture"
                            android:elevation="3dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/night" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/accountName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Oru.Title"
                            android:textColor="@color/ink" />

                        <TextView
                            android:id="@+id/accountMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                            android:textColor="@color/ink_soft" />

                        <TextView
                            android:id="@+id/accountEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                            android:textColor="@color/ink_faint" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/accountBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.25"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink_soft"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editProfileButton"
                        style="@style/Widget.Oru.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Edit profile"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart"
                        app:iconTint="@color/night" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removePictureButton"
                        style="@style/Widget.Oru.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Remove picture"
                        android:textColor="@color/ink_soft"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- Appearance -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="4dp"
                android:text="Appearance"
                android:textAppearance="@style/TextAppearance.Oru.Label"
                android:textColor="@color/ink_faint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Theme"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="System follows your phone's dark mode."
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/ink_faint" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/themeChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/themeSystem"
                        style="@style/Widget.Oru.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="System" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/themeLight"
                        style="@style/Widget.Oru.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/themeDark"
                        style="@style/Widget.Oru.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dark" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <!-- Profile pictures -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="4dp"
                android:text="Pictures"
                android:textAppearance="@style/TextAppearance.Oru.Label"
                android:textColor="@color/ink_faint" />

            <LinearLayout
                android:id="@+id/bannerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:background="@drawable/artwork_rounded">

                    <ImageView
                        android:id="@+id/bannerImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToOutline="true"
                        android:contentDescription="Your banner"
                        android:scaleType="centerCrop" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Profile banner"
                    android:textAppearance="@style/TextAppearance.Oru.Body"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The wide picture behind your name, on your profile and artist page."
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/ink_faint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bannerButton"
                        style="@style/Widget.Oru.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Change banner"
                        app:icon="@drawable/ic_image"
                        app:iconGravity="textStart"
                        app:iconTint="@color/flame_ink" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removeBannerButton"
                        style="@style/Widget.Oru.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Remove"
                        android:textColor="@color/ink_soft"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- Listening -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="4dp"
                android:text="Listening"
                android:textAppearance="@style/TextAppearance.Oru.Label"
                android:textColor="@color/ink_faint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:id="@+id/downloadsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_download"
                        app:tint="@color/flame_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Downloads"
                            android:textAppearance="@style/TextAppearance.Oru.Body"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Songs saved on this device"
                            android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                            android:textColor="@color/ink_faint" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ink_faint" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/permissionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/flame_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Playback notifications"
                            android:textAppearance="@style/TextAppearance.Oru.Body"
                            android:textColor="@color/ink" />

                        <TextView
                            android:id="@+id/permissionSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                            android:textColor="@color/ink_faint" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ink_faint" />

                </LinearLayout>

            </LinearLayout>

            <!-- Your work -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="4dp"
                android:text="Your work"
                android:textAppearance="@style/TextAppearance.Oru.Label"
                android:textColor="@color/ink_faint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:id="@+id/studioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_studio"
                        app:tint="@color/flame_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Your studio"
                            android:textAppearance="@style/TextAppearance.Oru.Body"
                            android:textColor="@color/ink" />

                        <TextView
                            android:id="@+id/studioSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                            android:textColor="@color/ink_faint" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ink_faint" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/reportsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_report"
                        app:tint="@color/flame_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Reports"
                            android:textAppearance="@style/TextAppearance.Oru.Body"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Moderation queue"
                            android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                            android:textColor="@color/ink_faint" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ink_faint" />

                </LinearLayout>

            </LinearLayout>

            <!-- About -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="4dp"
                android:text="About"
                android:textAppearance="@style/TextAppearance.Oru.Label"
                android:textColor="@color/ink_faint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:id="@+id/aboutButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_music"
                        app:tint="@color/flame_ink" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="About ORU"
                        android:textAppearance="@style/TextAppearance.Oru.Body"
                        android:textColor="@color/ink" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ink_faint" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/githubButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_share"
                        app:tint="@color/flame_ink" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="The developer"
                        android:textAppearance="@style/TextAppearance.Oru.Body"
                        android:textColor="@color/ink" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ink_faint" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signOutButton"
                style="@style/Widget.Oru.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Log out"
                android:textColor="@color/flame_ink"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/flame_ink"
                app:strokeColor="@color/flame" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Oru.Label"
                android:textColor="@color/ink_faint" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
