<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_deep"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="@color/ink"
        app:subtitleTextColor="@color/ink_faint"
        app:title="Record a song"
        app:titleTextColor="@color/ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Recording: one take, straight into the editor afterwards. -->
            <LinearLayout
                android:id="@+id/recordPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/flame_soft"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/flame" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="0:00"
                    android:textAppearance="@style/TextAppearance.Oru.Headline"
                    android:textColor="@color/ink"
                    android:textIsSelectable="false" />

                <TextView
                    android:id="@+id/recordHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Sing it in one take. You can trim it after."
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/ink_soft" />

                <TextView
                    android:id="@+id/recordError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/flame_ink"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recordButton"
                    style="@style/Widget.Oru.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Start recording"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart" />

            </LinearLayout>

            <!-- Editing: the picture of the sound, the two cut points, fades. -->
            <LinearLayout
                android:id="@+id/editPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit audio"
                    android:textAppearance="@style/TextAppearance.Oru.Label"
                    android:textColor="@color/ink_faint" />

                <TextView
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Oru.Title"
                    android:textColor="@color/ink" />

                <com.oru.app.ui.components.WaveformView
                    android:id="@+id/waveform"
                    android:layout_width="match_parent"
                    android:layout_height="108dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/tile_background" />

                <TextView
                    android:id="@+id/editStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Reading the sound"
                    android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                    android:textColor="@color/ink_soft"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/startLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Starts at 0:00"
                    android:textAppearance="@style/TextAppearance.Oru.Label"
                    android:textColor="@color/ink_faint" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/startSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="1"
                    app:labelBehavior="gone" />

                <TextView
                    android:id="@+id/endLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ends at 0:00"
                    android:textAppearance="@style/TextAppearance.Oru.Label"
                    android:textColor="@color/ink_faint" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/endSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1"
                    android:valueFrom="0"
                    android:valueTo="1"
                    app:labelBehavior="gone" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/editChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFadeIn"
                        style="@style/Widget.Oru.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fade in" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFadeOut"
                        style="@style/Widget.Oru.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fade out" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEven"
                        style="@style/Widget.Oru.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Even volume" />

                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/previewButton"
                        style="@style/Widget.Oru.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hear it"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/keepText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keeping 0:00"
                        android:textAppearance="@style/TextAppearance.Oru.BodySoft"
                        android:textColor="@color/ink_soft" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelButton"
                        style="@style/Widget.Oru.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancel" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/applyButton"
                        style="@style/Widget.Oru.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use this clip" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/editProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="@color/flame"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
