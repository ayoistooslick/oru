<?xml version="1.0" encoding="utf-8"?>
<!-- A card in the "New songs" rail: artwork, title, artist. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="136dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/cardCover"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:background="@drawable/artwork_rounded"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music" />

    <TextView
        android:id="@+id/cardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Oru.Body"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/cardArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Oru.BodySoft"
        android:textColor="@color/ink_soft" />

</LinearLayout>
