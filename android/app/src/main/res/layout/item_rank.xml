<?xml version="1.0" encoding="utf-8"?>
<!-- One place on the weekly chart: rank, song, plays, play. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/rankText"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Oru.Title"
        android:textColor="@color/ink_faint" />

    <ImageView
        android:id="@+id/rankCover"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/artwork_rounded"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rankTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Oru.Body"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/rankArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Oru.BodySoft"
            android:textColor="@color/ink_soft" />

    </LinearLayout>

    <TextView
        android:id="@+id/rankPlays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.Oru.Label"
        android:textColor="@color/ink_faint" />

    <ImageButton
        android:id="@+id/rankPlay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_play"
        app:tint="@color/flame" />

</LinearLayout>
