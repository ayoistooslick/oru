<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Audio playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Uploads go through the system photo picker and document picker, which
         grant per-file access, so no storage permission is requested. -->

    <!-- Recording a take in the studio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OruApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Oru"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Oru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Oru" />

        <!-- The browser's Google sign-in comes back here as oru://auth?code=… -->
        <activity
            android:name=".ui.auth.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Oru">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="oru" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- Every oru.freebuff.app page, addressed in the app's own scheme.
             The web hands links over as Android intent URLs, so a listener who
             has the app opens it instead of the browser, on the screen the
             link named. Hosts mirror appLinkFor() in src/lib/links.ts. -->
        <activity
            android:name=".ui.OpenLinkActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Oru">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Content: oru://song/12, oru://artist/4, oru://release/7,
                     oru://playlist/3 -->
                <data android:scheme="oru" android:host="song" />
                <data android:scheme="oru" android:host="artist" />
                <data android:scheme="oru" android:host="release" />
                <data android:scheme="oru" android:host="playlist" />
                <!-- Tabs and the screens behind them -->
                <data android:scheme="oru" android:host="listen" />
                <data android:scheme="oru" android:host="library" />
                <data android:scheme="oru" android:host="search" />
                <data android:scheme="oru" android:host="studio" />
                <data android:scheme="oru" android:host="notifications" />
                <data android:scheme="oru" android:host="settings" />
                <data android:scheme="oru" android:host="shares" />
                <data android:scheme="oru" android:host="moderation" />
                <data android:scheme="oru" android:host="about" />
            </intent-filter>

            <!-- Verified App Links: the site's own addresses open the app
                 directly, with no browser frame and no chooser. Android checks
                 https://oru.freebuff.app/.well-known/assetlinks.json against the
                 signing certificate at install time; the fingerprint there is
                 the release key in android/keystore. The oru:// filter above
                 stays as the fallback for builds signed with another key and
                 for browsers that refuse intent addresses. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="oru.freebuff.app" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.artist.ArtistActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.release.ReleaseActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.playlist.PlaylistActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.library.LikedSongsActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.studio.UploadActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.shares.ShareActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.moderation.ModerationActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.downloads.DownloadsActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.studio.AudioStudioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Oru" />

        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <!-- The bell: drops from the artists this listener follows. -->
        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.Oru" />

        <!-- Media playback foreground service -->
        <service
            android:name=".media.PlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Workaround: file provider for sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
