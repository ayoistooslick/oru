# Local development uses SQLite. For PostgreSQL, set a postgresql+psycopg:// URL.
DATABASE_URL=sqlite:///./oru.db

# Replace this before any deployment with a long random value.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# JSON array of exact frontend origins. Add your local frontend URL here.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

MEDIA_DIRECTORY=./data/media
MAX_AUDIO_BYTES=104857600
MAX_IMAGE_BYTES=10485760

# Comma-separated moderator accounts, set before registering those accounts.
ADMIN_EMAILS=
ENVIRONMENT=development
